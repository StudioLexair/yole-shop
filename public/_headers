  Cache-Control: public, max-age=86400

/favicon.ico
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

/favicon-64x64.png
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/version.json
  Cache-Control: no-cache, no-store, must-revalidate

/banners/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
